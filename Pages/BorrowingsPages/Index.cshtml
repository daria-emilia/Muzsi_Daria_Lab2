@page
@model Muzsi_Daria_Lab2.Pages.BorrowingsPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Borrowings[0].MembersID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Borrowings[0].Members)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Borrowings[0].BookID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Borrowings[0].Book)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Borrowings[0].Book.Author)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Borrowings[0].ReturnDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Borrowings) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.MembersID)
            </td>
            <td>
                @Html.DisplayFor(model => item.Members.FullName)
            </td>
            <td>
                @Html.DisplayFor(model => item.BookID)
            </td>
            <td>
                @Html.DisplayFor(model => item.Book.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.Book.Author.FullName)
            </td>
            <td>
                @Html.DisplayFor(model => item.ReturnDate)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>